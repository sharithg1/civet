{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Everything the Civet UI needs: core IPC, events and every civet-desktop command.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "allow-connect-host",
    "allow-reconnect-host",
    "allow-restart-daemon",
    "allow-disconnect-host",
    "allow-list-hosts",
    "allow-notify-network-change",
    "allow-daemon-info",
    "allow-ping",
    "allow-list-repos",
    "allow-add-repo",
    "allow-remove-repo",
    "allow-prepare-file-drop",
    "allow-upload-file",
    "allow-list-worktrees",
    "allow-list-pull-requests",
    "allow-create-worktree",
    "allow-remove-worktree",
    "allow-list-files",
    "allow-read-file",
    "allow-list-all-files",
    "allow-list-panes",
    "allow-spawn-pane",
    "allow-launch-agent",
    "allow-attach-pane",
    "allow-detach-pane",
    "allow-write-input",
    "allow-write-input-binary",
    "allow-resize-pane",
    "allow-kill-pane",
    "allow-fetch-scrollback",
    "allow-set-agent-status",
    "allow-set-prediction",
    "allow-write-clipboard",
    "allow-list-ports",
    "allow-forward-port",
    "allow-stop-forward",
    "allow-list-forwards",
    "allow-open-local-url",
    "allow-open-pull-request"
  ]
}
