{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Civet",
  "version": "0.1.19",
  "identifier": "dev.civet.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "ui/dist",
    "beforeDevCommand": {
      "script": "pnpm --dir ui dev",
      "cwd": ".",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "../../scripts/build-remote.sh --bundle && pnpm --dir ui build",
      "cwd": "."
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Civet",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundColor": "#151616",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Remote-first workspace for coding agents",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "resources": {
      "civet-dist/": "civet-dist/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0QUU0MEI4NkUwMDZBREIKUldUYmFnQnV1RUN1Uk9DZThNT09WbUNmc0JmbFhmSmpmOGt2VnZnM2Roa1VkMTJPR2hPdElNZWsK",
      "endpoints": ["https://github.com/sharithg1/civet/releases/latest/download/latest.json"]
    }
  }
}
