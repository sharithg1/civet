{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Civet",
  "version": "0.1.1",
  "identifier": "dev.civet.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "ui/dist",
    "beforeDevCommand": {
      "script": "pnpm --dir ui dev",
      "cwd": ".",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "pnpm --dir ui build",
      "cwd": "."
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Civet",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundColor": "#1e2229"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Remote-first workspace for coding agents",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
