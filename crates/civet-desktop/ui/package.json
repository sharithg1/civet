  "version": "0.1.0",
  "type": "module",
  "description": "Civet desktop frontend (React + xterm.js), hosted by the Tauri shell in ../",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
