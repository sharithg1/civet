    "@xterm/xterm": "6.1.0-beta.304",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "tailwindcss": "^4.2.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
